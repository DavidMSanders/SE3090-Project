<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AndroidExample" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/button_primary</item>
        <item name="colorOnPrimary">@color/button_on_primary</item>
        <item name="colorSecondary">@color/calendar_selected_day</item>
        <item name="colorOnSecondary">@color/app_text_primary</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="android:colorBackground">@color/app_bg</item>
        <item name="android:buttonStyle">@style/Widget.AndroidExample.Button.Rounded</item>
    </style>

    <style name="Theme.AndroidExample" parent="Base.Theme.AndroidExample" />

    <style name="Widget.AndroidExample.Button.Rounded" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_rounded</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>

</resources>