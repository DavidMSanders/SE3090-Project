<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">


        <TextView
            android:id="@+id/CreatelabelName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name:"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <EditText
            android:id="@+id/CreateitemWorkoutName"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:inputType="text"
            android:textSize="18sp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:maxLines="1"
            app:layout_constraintStart_toEndOf="@id/CreatelabelName"
            app:layout_constraintTop_toTopOf="@id/CreatelabelName"
            app:layout_constraintEnd_toEndOf="parent" />



        <TextView
            android:id="@+id/CreatelabelDate"
            android:layout_width="63dp"
            android:layout_height="42dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="8dp"
            android:text="Date:"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/CreateitemWorkoutName" />

        <!-- Duration label -->

        <!-- Duration field -->

        <EditText
            android:id="@+id/CreateitemWorkoutDate"
            android:layout_width="141dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:inputType="text"
            android:hint = "MM/dd/yyyy"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.038"
            app:layout_constraintStart_toEndOf="@id/CreatelabelDate"
            app:layout_constraintTop_toTopOf="@id/CreatelabelDate" />

        <TextView
            android:id="@+id/CreatelabelDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Duration:"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/CreateitemWorkoutDate" />

        <!-- Description label -->

        <!-- Description field -->

        <EditText
            android:id="@+id/CreateitemWorkoutDuration"
            android:layout_width="131dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:inputType="number"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toEndOf="@id/CreatelabelDuration"
            app:layout_constraintTop_toTopOf="@id/CreatelabelDuration" />

        <TextView
            android:id="@+id/CreatelabelDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:text="Description:"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/CreateitemWorkoutDuration" />

        <EditText
            android:id="@+id/CreateitemWorkoutDescription"
            android:layout_width="269dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/CreatelabelDescription"
            app:layout_constraintTop_toTopOf="@id/CreatelabelDescription" />

        <!-- Save Button -->

        <!-- Delete Button -->

        <Button
            android:id="@+id/btnCreateWorkout"
            android:layout_width="169dp"
            android:layout_height="37dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:text="Create Workout"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/CreateitemWorkoutDescription" />

        <TextView
            android:id="@+id/CreatedurationUnits"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="(minutes)"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/CreateitemWorkoutDuration"
            app:layout_constraintStart_toEndOf="@id/CreateitemWorkoutDuration"
            app:layout_constraintTop_toTopOf="@id/CreateitemWorkoutDuration"
            app:layout_constraintVertical_bias="0.555" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>