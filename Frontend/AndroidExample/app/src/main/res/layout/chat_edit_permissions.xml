<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvEditPermissionsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Permissions"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvTargetUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <CheckBox
        android:id="@+id/cbCanSendMessages"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Can Send Messages" />

    <CheckBox
        android:id="@+id/cbCanManageMembers"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Can Manage Members" />

    <CheckBox
        android:id="@+id/cbCanPostAnnouncements"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Can Post Announcements" />

    <CheckBox
        android:id="@+id/cbCanAssignWorkouts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Can Assign Workouts" />

    <Button
        android:id="@+id/btnSavePermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save"
        android:layout_marginTop="16dp" />
</LinearLayout>