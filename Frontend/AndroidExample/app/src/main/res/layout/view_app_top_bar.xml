<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/topBarContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0E3A53"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="vertical"
    android:paddingTop="0dp"
    android:paddingBottom="6dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTopNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/top_bar_button_blocky"
            android:backgroundTint="#1565C0"
            android:minHeight="34dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            app:backgroundTint="#1565C0"
            android:textColor="#FFFFFFFF"
            android:text="Notifications"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnTopHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/top_bar_button_blocky"
            android:backgroundTint="#1565C0"
            android:minHeight="34dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            app:backgroundTint="#1565C0"
            android:textColor="#FFFFFFFF"
            android:text="Home"
            android:textAllCaps="false" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnTopUserMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/top_bar_button_blocky"
            android:backgroundTint="#1565C0"
            android:minHeight="34dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            app:backgroundTint="#1565C0"
            android:textColor="#FFFFFFFF"
            android:text="Guest v"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
