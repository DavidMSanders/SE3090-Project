<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true"
    tools:context=".CalendarActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_app_top_bar" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Workout Calendar"
                android:textColor="@color/app_text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:text="Plan, update, and share sessions"
                android:textColor="@color/app_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/app_surface"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvCurrentMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/app_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="April 2026" />

                <com.github.sundeepk.compactcalendarview.CompactCalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                        app:compactCalendarBackgroundColor="@color/app_surface_alt"
                        app:compactCalendarCurrentDayBackgroundColor="@color/calendar_current_day"
                        app:compactCalendarCurrentSelectedDayBackgroundColor="@color/calendar_selected_day"
                        app:compactCalendarMultiEventIndicatorColor="@color/calendar_multi_event"
                    app:compactCalendarTargetHeight="250dp"
                        app:compactCalendarTextColor="@color/app_text_primary"
                    app:compactCalendarTextSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Event Details"
                android:textColor="@color/app_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEventTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/app_divider"
                android:hint="Workout title"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:padding="10dp" />

            <EditText
                android:id="@+id/etEventDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/app_divider"
                android:hint="Workout notes"
                android:inputType="textMultiLine"
                android:minLines="2"
                android:padding="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <EditText
                    android:id="@+id/etStartTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="@color/app_divider"
                    android:hint="Start (HH:mm)"
                    android:inputType="time"
                    android:maxLines="1"
                    android:padding="10dp" />

                <EditText
                    android:id="@+id/etEndTime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/app_divider"
                    android:hint="End (HH:mm)"
                    android:inputType="time"
                    android:maxLines="1"
                    android:padding="10dp" />
            </LinearLayout>

            <Spinner
                android:id="@+id/eventTypeSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/app_divider"
                android:padding="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <Button
                    android:id="@+id/btnSaveEvent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#2E7D32"
                    android:text="Save"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />

                <Button
                    android:id="@+id/btnEditEvent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#1565C0"
                    android:text="Edit"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />

                <Button
                    android:id="@+id/btnDeleteEvent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="#C62828"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Invite Participant"
                android:textColor="@color/app_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etShareUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/app_divider"
                android:hint="Enter user ID"
                android:inputType="number"
                android:padding="10dp" />

            <Button
                android:id="@+id/btnShareEvent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#0B7285"
                android:text="Invite to Workout"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Participants"
                android:textColor="@color/app_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvParticipantsBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/app_surface"
                android:padding="10dp"
                android:text="Select an event to view participants."
                android:textColor="@color/app_text_body"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
