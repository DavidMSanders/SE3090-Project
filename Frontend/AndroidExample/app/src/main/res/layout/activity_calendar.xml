<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.github.sundeepk.compactcalendarview.CompactCalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        app:compactCalendarTargetHeight="250dp"
        app:compactCalendarTextSize="12sp"
        app:compactCalendarBackgroundColor="#FFE0E0E0"
        app:compactCalendarTextColor="#FF000000"
        app:compactCalendarCurrentSelectedDayBackgroundColor="#FF0000"
        app:compactCalendarCurrentDayBackgroundColor="#FF0000"
        app:compactCalendarMultiEventIndicatorColor="#FF0000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />

    <EditText
        android:id="@+id/etEventDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Event Description"
        app:layout_constraintTop_toBottomOf="@id/calendarView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnSaveEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save Event"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etEventDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnEditEvent"
        app:layout_constraintHorizontal_chainStyle="packed"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnEditEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Event"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/etEventDescription"
        app:layout_constraintStart_toEndOf="@id/btnSaveEvent"
        app:layout_constraintEnd_toStartOf="@id/btnDeleteEvent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/btnDeleteEvent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete Event"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FF0000"
        app:layout_constraintTop_toBottomOf="@id/etEventDescription"
        app:layout_constraintStart_toEndOf="@id/btnEditEvent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>