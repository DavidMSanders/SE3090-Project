<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Back button -->
        <Button
            android:id="@+id/btnBackCreateWorkoutPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#0031FD"
            android:text="Back" />

        <EditText
            android:id="@+id/etWorkoutPlanName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Workout Plan Name" />

        <EditText
            android:id="@+id/etWorkoutPlanDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Workout Plan Description"
            android:inputType="textMultiLine"
            android:minLines="4" />

        <Button
            android:id="@+id/btnSubmitWorkoutPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#01AF05"
            android:text="Create Workout Plan" />

    </LinearLayout>
</ScrollView>