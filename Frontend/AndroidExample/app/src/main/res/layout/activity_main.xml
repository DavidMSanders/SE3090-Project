<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    tools:context=".MainActivity">

    <include
        android:id="@+id/appTopBar"
        layout="@layout/view_app_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvCurrentUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginTop="16dp"
        android:text="Not logged in"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageView" />

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:text="Sign Out"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCurrentUser" />

    <ScrollView
        android:id="@+id/scrollButtons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/btnLogout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnWorkoutPlans"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Workout Plans"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnTestingPage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Testing Page"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnGroupList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Group List"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/WorkoutList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Workout List"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnPersonalBests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Bests"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGoToCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Go to Calendar"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnGoToWorkout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Go to Workout Page"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btnGoToDelete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Go to Delete Page"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>
