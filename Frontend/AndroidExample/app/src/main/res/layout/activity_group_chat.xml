<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".GroupChatActivity">

    <include
        android:id="@+id/appTopBar"
        layout="@layout/view_app_top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <Button
        android:id="@+id/btnLeaveGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leave Group"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/appTopBar"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp" />
    <!-- Hidden announcement only for those with the announcement permissionnnn-->
    <Button
        android:id="@+id/btnAnnouncement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Announcement"

        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@id/btnLeaveGroup"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"/>

    <!-- Update Group Button -->
    <Button
        android:id="@+id/btnUpdateGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Update Group"
        android:visibility="gone"

        app:layout_constraintTop_toBottomOf="@id/btnAnnouncement"
        app:layout_constraintStart_toStartOf="@id/btnAnnouncement"
        android:layout_marginTop="8dp"/>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/chatActionsBottomBarrier"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="btnLeaveGroup,btnAnnouncement,btnUpdateGroup" />

    <LinearLayout
        android:id="@+id/groupTitleContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="@id/btnLeaveGroup"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnLeaveGroup"
        app:layout_constraintTop_toTopOf="@id/btnLeaveGroup">

        <TextView
            android:id="@+id/tvChatGroupTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Group Chat"
            android:textColor="@color/app_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGroupId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="ID: —"
            android:textColor="@color/app_text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <View
        android:id="@+id/topDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/app_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chatActionsBottomBarrier" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="8dp"
        android:paddingTop="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        tools:listitem="@layout/our_message_box"
        app:layout_constraintTop_toBottomOf="@id/topDivider"
        app:layout_constraintBottom_toTopOf="@id/chatInputBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatInputBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/app_surface"
        android:paddingStart="10dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@android:drawable/edit_text"
            android:backgroundTint="@color/app_divider"
            android:gravity="top|start"
            android:hint="Type a message"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:textColor="@color/app_text_primary"
            android:textColorHint="@color/app_text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnSendMessage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/btnSendMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="72dp"
            android:text="Send"
            app:layout_constraintBottom_toBottomOf="@id/etChatMessage"
            app:layout_constraintEnd_toStartOf="@id/btnSendImage"
            app:layout_constraintTop_toTopOf="@id/etChatMessage" />

        <Button
            android:id="@+id/btnSendImage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="56dp"
            android:text="📷"
            android:textSize="18sp"
            android:contentDescription="Send image"
            app:layout_constraintBottom_toBottomOf="@id/etChatMessage"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/etChatMessage" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>